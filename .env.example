# Set these as environment variables (the app does not load a .env file automatically).
# Windows (cmd):  set SESSION_SECRET=a-long-random-string
# Linux/macOS:    export SESSION_SECRET=a-long-random-string
WALLET_KEY_FILE=service-account.json
WALLET_ISSUER_ID=your_issuer_id_here
SESSION_SECRET=a-long-random-string
